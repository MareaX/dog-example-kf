<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dim_16"
    android:paddingBottom="@dimen/dim_24">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_vertical_36"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.40" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_dog_photo"
        android:layout_width="@dimen/dim_0"
        android:layout_height="@dimen/dim_252dp"
        android:contentDescription="@string/lbl_dog_image"
        android:scaleType="fitXY"
        android:src="@drawable/ic_launcher_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/gl_vertical_36"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/circleImageView" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_dog_container"
        style="@style/ShapeAppearanceOverlay.MaterialCardView.Cut"
        android:layout_width="@dimen/dim_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dim_16"
        app:cardBackgroundColor="@color/card_color"
        app:layout_constraintBottom_toBottomOf="@id/iv_dog_photo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/gl_vertical_36"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/dim_16">

            <TextView
                android:id="@+id/tv_dog_name"
                android:layout_width="@dimen/dim_0"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadline2"
                android:textColor="@color/primary_text_color"
                android:textSize="@dimen/text_18"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Chief" />

            <TextView
                android:id="@+id/tv_dog_description"
                android:layout_width="@dimen/dim_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_8"
                android:text="?attr/textAppearanceBody1"
                android:textColor="@color/secondary_text_color"
                android:textSize="@dimen/text_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/tv_dog_name"
                app:layout_constraintTop_toBottomOf="@id/tv_dog_name"
                tools:text="Black (formerly) White with black spots, he don´t trust anyone, White with black spots, he don´t trust anyone, White with black spots, he don´t trust anyone," />

            <TextView
                android:id="@+id/tv_dog_age"
                android:layout_width="@dimen/dim_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_24"
                android:layout_marginBottom="@dimen/dim_16"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textColor="#333333"
                android:textSize="@dimen/text_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/tv_dog_description"
                app:layout_constraintTop_toBottomOf="@id/tv_dog_description"
                tools:text="Almost 2 years" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>